{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cra-fill-structured-form/template-config.schema.json",
  "title": "CRA structured form template configuration",
  "type": "object",
  "required": ["schema_version", "config_id", "version", "status", "form_type", "template", "fields", "approval"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "config_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "enabled", "disabled"]},
    "form_type": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "enabled_at": {"type": "string", "minLength": 1},
    "disabled_at": {"type": "string", "minLength": 1},
    "disabled_reason": {"type": "string", "minLength": 1},
    "template": {
      "type": "object",
      "required": ["file_name", "sha256", "structure_fingerprint", "format"],
      "additionalProperties": false,
      "properties": {
        "file_name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "structure_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "format": {"enum": ["docx", "xlsx"]}
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "fact_key", "target", "mapping", "mapping_review"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "fact_key": {"type": ["string", "null"]},
          "target": {
            "oneOf": [
              {
                "type": "object",
                "required": ["table", "row", "column", "expected_original"],
                "properties": {
                  "table": {"type": "integer", "minimum": 0},
                  "row": {"type": "integer", "minimum": 0},
                  "column": {"type": "integer", "minimum": 0},
                  "expected_original": {"type": "string"}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["sheet", "cell", "expected_original"],
                "properties": {
                  "sheet": {"type": "string", "minLength": 1},
                  "cell": {"type": "string", "pattern": "^\\$?[A-Z]{1,3}\\$?[1-9][0-9]*$"},
                  "expected_original": {"type": "string"}
                },
                "additionalProperties": false
              }
            ]
          },
          "mapping": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type"],
                "properties": {"type": {"const": "manual"}},
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["type", "mode"],
                "properties": {
                  "type": {"const": "direct"},
                  "mode": {"enum": ["cell", "inline_after_anchor"]},
                  "anchor": {"type": "string", "minLength": 1}
                },
                "allOf": [
                  {"if": {"properties": {"mode": {"const": "inline_after_anchor"}}}, "then": {"required": ["anchor"]}}
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["type", "unchecked", "checked", "value_to_option"],
                "properties": {
                  "type": {"const": "choice"},
                  "unchecked": {"type": "string", "minLength": 1, "maxLength": 1},
                  "checked": {"type": "string", "minLength": 1, "maxLength": 1},
                  "value_to_option": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {"type": "string", "minLength": 1}
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "mapping_review": {"enum": ["proposed", "approved"]}
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["approved_by", "approved_at", "approval_id"],
      "additionalProperties": false,
      "properties": {
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"]},
        "approval_id": {"type": ["string", "null"]}
      }
    }
  }
}
